#compdef ntree
# zsh completion for ntree
# Commands and workspace names come from `ntree __complete`, so this file never
# drifts from the CLI and works from inside a worktree too.

_ntree_workspaces() {
  local -a ws
  ws=(${(f)"$(command ntree __complete workspaces 2>/dev/null)"})
  _describe -t workspaces 'workspace' ws
}

_ntree_branches() {
  local -a br
  br=(${(f)"$(git branch --format='%(refname:short)' 2>/dev/null)"})
  _describe -t branches 'branch' br
}

_ntree() {
  if (( CURRENT == 2 )); then
    local -a cmds
    cmds=(${(f)"$(command ntree __complete commands 2>/dev/null)"})
    _describe -t commands 'command' cmds
    _ntree_workspaces
    return
  fi

  case "$words[2]" in
    stop|open|git|desc|sync|sync-deps|path|cd|rm)
      (( CURRENT == 3 )) && _ntree_workspaces ;;
    new)
      _arguments '--from[base branch]:branch:_ntree_branches' '--ports[ports to reserve]:count' \
        '(-m --desc)'{-m,--desc}'[short description]:description' '*:branch:_ntree_branches' ;;
    run)
      _arguments '--from[base branch]:branch:_ntree_branches' '--ports[ports to reserve]:count' \
        '(-m --desc)'{-m,--desc}'[short description]:description' '--rm[remove workspace after]' '(-d --detach)'{-d,--detach}'[run in background]' '*:branch:_ntree_branches' ;;
  esac
}

_ntree "$@"
