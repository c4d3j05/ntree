#!/usr/bin/env bash
#
# ntree — run multiple branches of one repo in parallel workspaces,
#         without duplicating file content on disk.
#
# Stack: git worktree + copy-on-write clones (APFS / reflink) + bash.
# See: https://github.com/c4d3j05/ntree
#
set -euo pipefail

readonly NTREE_VERSION="0.1.0"

# Every subcommand, in one place: shell-init and the completions derive from
# this list, so a new command can't be forgotten in one of them.
readonly NTREE_COMMANDS="new run list ls stop open git sync sync-deps allow path cd rm doctor shell-init version help"

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------
if [[ -t 2 ]]; then
  readonly C_RED=$'\033[31m' C_GRN=$'\033[32m' C_YLW=$'\033[33m'
  readonly C_BLD=$'\033[1m' C_RST=$'\033[0m'
else
  readonly C_RED='' C_GRN='' C_YLW='' C_BLD='' C_RST=''
fi

info()  { printf '%s\n' "$*" >&2; }
warn()  { printf '%swarning:%s %s\n' "$C_YLW" "$C_RST" "$*" >&2; }
die()   { printf '%serror:%s %s\n'   "$C_RED" "$C_RST" "$*" >&2; exit 1; }
ok()    { printf '%s✓%s %s\n'        "$C_GRN" "$C_RST" "$*" >&2; }

# ---------------------------------------------------------------------------
# Dependency + repo discovery
# ---------------------------------------------------------------------------
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

# Resolve the MAIN worktree root (where .ntree/ lives), even when invoked from
# inside a linked worktree or a subdirectory. Worktrees share one common git dir
# (<main>/.git), so the main root is its parent.
repo_root() {
  local cdir
  cdir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || die "not inside a git repository"
  dirname "$cdir"
}

# Globals populated by init_env
REPO_ROOT="" NTREE_DIR="" STATE_FILE="" LOCK_DIR="" RC_FILE="" NTREE_CMD=""
NEW_BRANCH_TIP=""   # set by _build_ws when it created the branch (commit it started at)
INTERRUPTED=0       # set by an INT/TERM trap while ntree must finish cleaning up

# Where trusted .ntreerc hashes are recorded (direnv-style allow-list).
readonly ALLOW_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/ntree/allowed"

# Ports reserved by every ntree workspace on this machine, across repos, so two
# repos never hand out the same port. One "<port> <workspace path>" per line.
readonly PORT_REGISTRY="${XDG_STATE_HOME:-$HOME/.local/state}/ntree/ports"

# Config (defaults; overridable via a trusted .ntreerc)
NTREE_START_CMD=""          # optional default command for `ntree run` (remembered per ws)
NTREE_SETUP_CMD=""          # optional: run on `new` to install deps correctly for the
                            # branch, e.g. 'npm ci', 'pnpm i', 'uv sync', 'bundle install'
NTREE_PORT_RANGE_START=3001
NTREE_PORT_RANGE_END=3099
NTREE_CLONE_DIRS=""         # opt-in speed hack: COW-clone these untracked dirs from main
                            # (best for a big npm/yarn node_modules; it's a snapshot, so
                            # prefer NTREE_SETUP_CMD for correctness). Never put .venv here
                            # — virtualenvs hardcode absolute paths and break when copied.
NTREE_LINK_PATHS=""         # untracked files/dirs shared live by every workspace: each
                            # workspace gets a symlink to main's copy (e.g. 'notes .env')
NTREE_PORT_COUNT=1          # ports reserved per workspace (PORT, PORT2, PORT3, ...)
NTREE_PORTS=""              # optional friendly port names, e.g. 'API FRONTEND'. When set,
                            # its length is the port count and each port also gets a
                            # <NAME>_PORT alias (API_PORT, FRONTEND_PORT) alongside PORT/PORT2.

rc_hash() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" 2>/dev/null | awk '{print $1}'
  else shasum -a 256 "$1" 2>/dev/null | awk '{print $1}'; fi
}

# Copy-on-write recursive copy: APFS clonefile on macOS, reflink on Linux
# (btrfs/XFS/bcachefs). Fails (non-zero) if the filesystem can't clone, so the
# caller can fall back to a plain copy.
cow_copy() {
  if [[ "$(uname -s)" == "Darwin" ]]; then cp -c -R "$1" "$2" 2>/dev/null
  else cp -R --reflink=always "$1" "$2" 2>/dev/null; fi
}
rc_is_allowed() { [[ -f "$ALLOW_FILE" ]] && grep -qxF "$1" "$ALLOW_FILE"; }

init_env() {
  need git; need jq
  REPO_ROOT="$(repo_root)"
  NTREE_DIR="$REPO_ROOT/.ntree"
  STATE_FILE="$NTREE_DIR/state.json"
  LOCK_DIR="$NTREE_DIR/.lock"
  RC_FILE="$REPO_ROOT/.ntreerc"

  # .ntree/ is created lazily by the first write (see lock), so read-only
  # commands — and the shell function's `ntree path` probe — leave repos untouched.

  # .ntreerc is sourced as bash → only load it if the user has trusted it.
  if [[ -f "$RC_FILE" ]]; then
    if rc_is_allowed "$(rc_hash "$RC_FILE")"; then
      # shellcheck disable=SC1090
      source "$RC_FILE"
    elif [[ "$NTREE_CMD" != allow && "$NTREE_CMD" != sync && "$NTREE_CMD" != sync-deps ]]; then
      warn ".ntreerc present but not trusted — using built-in defaults."
      warn "review it, then run 'ntree allow' to load it (re-run after any edit)."
    fi
  fi

  # Never act on a corrupt state file: everything but doctor (which rebuilds it) stops.
  if [[ "$NTREE_CMD" != doctor ]] && ! _state_readable; then
    die "$STATE_FILE is unreadable — run 'ntree doctor' to rebuild it from the workspaces on disk"
  fi
}

_state_readable() {
  [[ ! -f "$STATE_FILE" ]] || jq -e '.workspaces | type == "object"' "$STATE_FILE" >/dev/null 2>&1
}

# Recreate state.json from the worktrees under .ntree/: branch from git, ports
# from each .env.workspace, links from what is linked. A running server's pid
# can't be recovered, so those show as stopped (stop still finds them by folder).
_rebuild_state() {
  local d name branch ports links p
  lock
  for d in "$NTREE_DIR"/*/; do
    [[ -e "$d/.git" ]] || continue
    name="$(basename "$d")"
    branch="$(git -C "$d" branch --show-current 2>/dev/null || true)"
    ports="$(sed -n 's/^PORT[0-9]*=//p' "$d/.env.workspace" 2>/dev/null | tr '\n' ' ')"
    links="$(_link_paths | while IFS= read -r p; do [[ -L "$d$p" ]] && echo "$p"; done)"
    state_update '.workspaces[$n] = {branch:$b, ports:($ports|split(" ")|map(select(length > 0)|tonumber)), links:($l|split("\n")|map(select(length > 0))), pid:null, created:null}' \
      --arg n "$name" --arg b "${branch:-$name}" --arg ports "$ports" --arg l "$links"
    info "  recovered $name (branch ${branch:-$name}, port(s) ${ports% })"
  done
  unlock
}

# ---------------------------------------------------------------------------
# Locking (macOS has no flock; mkdir is an atomic mutex). Two locks: the repo's
# state lock, and a machine-wide one for the port registry that every repo
# shares. Always take them in that order. Held locks are released on exit.
# ---------------------------------------------------------------------------
HELD_LOCKS=""

# Args: <lock dir> <what, for messages>
_acquire() {
  local dir="$1" what="$2" tries=0 holder
  while ! mkdir "$dir" 2>/dev/null; do
    # Self-heal a stale lock left behind by a crashed process (kill -9).
    holder="$(cat "$dir/pid" 2>/dev/null || true)"
    if [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; then
      warn "reclaiming stale $what lock (held by dead pid $holder)"
      rm -rf "$dir" 2>/dev/null || true
      continue
    fi
    (( tries++ >= 100 )) && die "could not acquire $what lock held by pid ${holder:-?} ($dir)"
    sleep 0.1
  done
  echo $$ > "$dir/pid"
  HELD_LOCKS="$HELD_LOCKS|$dir"
  trap '_release_all' EXIT
}
_release() {
  rm -rf "$1" 2>/dev/null || true
  HELD_LOCKS="${HELD_LOCKS//|$1/}"
}
_release_all() {
  local d rest="$HELD_LOCKS"
  while [[ -n "$rest" ]]; do
    rest="${rest#|}"; d="${rest%%|*}"; rest="${rest#"$d"}"
    rm -rf "$d" 2>/dev/null || true
  done
  HELD_LOCKS=""
}

lock() {
  mkdir -p "$NTREE_DIR"
  [[ -f "$STATE_FILE" ]] || echo '{"workspaces":{}}' > "$STATE_FILE"
  _acquire "$LOCK_DIR" state
}
unlock() { _release "$LOCK_DIR"; }

# The port registry lock. Re-entrant within one ntree process, so a caller can
# hold it across "pick free ports" and "record them".
REG_LOCKED=0
reg_lock() {
  (( REG_LOCKED )) && { REG_LOCKED=$((REG_LOCKED + 1)); return 0; }
  mkdir -p "$(dirname "$PORT_REGISTRY")"
  _acquire "$PORT_REGISTRY.lock" "port registry"
  REG_LOCKED=1
}
reg_unlock() {
  REG_LOCKED=$((REG_LOCKED - 1))
  (( REG_LOCKED > 0 )) || { REG_LOCKED=0; _release "$PORT_REGISTRY.lock"; }
}

# state_get '<jq filter>' [--arg name value ...]
state_get() {
  local filter="$1"; shift
  if [[ -f "$STATE_FILE" ]]; then jq -r "$@" "$filter" "$STATE_FILE"
  else jq -r "$@" "$filter" <<< '{"workspaces":{}}'; fi
}
# The branch checked out in a workspace right now (it may differ from the one it
# was created for, after a `git switch` inside it). Args: <name>
ws_branch() {
  local b; b="$(git -C "$(ws_path "$1")" branch --show-current 2>/dev/null || true)"
  if [[ -n "$b" ]]; then echo "$b"
  elif [[ -d "$(ws_path "$1")" ]]; then echo "(detached)"
  else ws_get "$1" '.branch'; fi
}

# One workspace's field. The name goes in as a jq argument, never into the
# filter text, so any branch name git allows is safe. Args: <name> '<filter>'
ws_get() { state_get ".workspaces[\$n]$2" --arg n "$1"; }

# state_update '<jq filter>' [--arg name value ...]. The temp file sits next to
# the state file so the final mv is an atomic rename (never across filesystems).
state_update() {
  local filter="$1"; shift
  local tmp; tmp="$(mktemp "$STATE_FILE.XXXXXX")"
  jq "$@" "$filter" "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
}

# ---------------------------------------------------------------------------
# Process / port helpers
# ---------------------------------------------------------------------------
pid_alive() { [[ -n "${1:-}" && "$1" != "null" ]] && kill -0 "$1" 2>/dev/null; }

# A process's start time. Recorded with the pid so a number reused after a
# reboot (or just later) is never mistaken for the workspace's server.
pid_start() { ps -o lstart= -p "$1" 2>/dev/null | sed 's/^ *//'; }

# Echo <name>'s background pid if that exact process is still running.
ws_pid() {
  local pid start; pid="$(ws_get "$1" '.pid')"; start="$(ws_get "$1" '.pid_start // empty')"
  pid_alive "$pid" && [[ -n "$start" && "$(pid_start "$pid")" == "$start" ]] && echo "$pid"
  return 0
}

# A port is "taken" if any workspace reserves it.
port_in_state() {
  state_get '.workspaces[].ports[]' 2>/dev/null \
    | grep -qx "$1"
}
# Check both stacks: `localhost` may resolve to ::1 while a server binds IPv4-only.
port_listening() {
  nc -z 127.0.0.1 "$1" >/dev/null 2>&1 || nc -z ::1 "$1" >/dev/null 2>&1
}

# Kill dev servers belonging to a worktree so teardown never leaves a zombie.
# Scans ALL TCP listeners and kills any whose working dir is inside the worktree
# — regardless of port, so a server on an unmapped/auto-picked port (Vite's 5173,
# a hardcoded port, a framework's next-free bump) is reclaimed too. Only listeners
# are targeted, so your interactive shell (cd'd in but not listening) is spared.
# TERM, brief wait, then KILL. Args: <worktree_path>
free_ports() {
  local wpath="$1"
  [[ -n "$wpath" && "$wpath" != "null" ]] || return 0
  command -v lsof >/dev/null 2>&1 || return 0

  # All TCP listeners on the machine → their pids.
  # (lsof exits non-zero on Linux when some procs are unreadable; that's fine.)
  local -a lpids=(); local lp
  while IFS= read -r lp; do lpids+=("$lp"); done < <(lsof -nP -iTCP -sTCP:LISTEN -t 2>/dev/null | sort -u)
  (( ${#lpids[@]} )) || return 0

  # Look up every listener's cwd in ONE lsof call; keep those inside the worktree.
  local pidcsv line pid="" cwd
  local -a doomed=()
  pidcsv="$(IFS=,; echo "${lpids[*]}")"
  while IFS= read -r line; do
    case "$line" in
      p*) pid="${line#p}" ;;
      n*) cwd="${line#n}"
          [[ "$cwd" == "$wpath" || "$cwd" == "$wpath"/* ]] && doomed+=("$pid") ;;
    esac
  done < <(lsof -a -d cwd -p "$pidcsv" -Fpn 2>/dev/null)

  (( ${#doomed[@]} )) || return 0
  local -a uniq=(); local d
  while IFS= read -r d; do uniq+=("$d"); done < <(printf '%s\n' "${doomed[@]}" | sort -u)
  for d in "${uniq[@]}"; do kill "$d" 2>/dev/null || true; done
  sleep 0.3
  for d in "${uniq[@]}"; do pid_alive "$d" && kill -9 "$d" 2>/dev/null || true; done
  info "killed worktree server(s) still running in $wpath (pid(s): ${uniq[*]})"
}

# Allocate <count> free ports (ascending, so never duplicated within a batch).
# Call under reg_lock (and record the result before releasing it). Echoes them space-separated.
alloc_ports() {
  local count="$1" p
  local -a found=()
  for (( p = NTREE_PORT_RANGE_START; p <= NTREE_PORT_RANGE_END; p++ )); do
    port_in_state "$p" && continue
    port_in_registry "$p" && continue
    port_listening "$p" && continue
    found+=("$p")
    (( ${#found[@]} == count )) && { echo "${found[*]}"; return 0; }
  done
  die "not enough free ports (need $count) in range $NTREE_PORT_RANGE_START-$NTREE_PORT_RANGE_END"
}

port_in_registry() { [[ -f "$PORT_REGISTRY" ]] && grep -q "^$1 " "$PORT_REGISTRY"; }

# Record <path>'s ports in the registry, replacing its old entries. With no
# ports, just drops them. Args: <workspace_path> [port...]
_registry_set() {
  local path="$1" p tmp; shift
  reg_lock
  tmp="$(mktemp "$PORT_REGISTRY.XXXXXX")"
  {
    [[ -f "$PORT_REGISTRY" ]] && awk -v w="$path" 'substr($0, index($0, " ") + 1) != w' "$PORT_REGISTRY"
    for p in "$@"; do printf '%s %s\n' "$p" "$path"; done
  } > "$tmp"
  mv "$tmp" "$PORT_REGISTRY"
  reg_unlock
}

# Drop registry entries whose workspace folder no longer exists (any repo).
_registry_prune() {
  [[ -f "$PORT_REGISTRY" ]] || return 0
  reg_lock
  local line tmp; tmp="$(mktemp "$PORT_REGISTRY.XXXXXX")"
  while IFS= read -r line; do
    [[ -d "${line#* }" ]] && printf '%s\n' "$line"
  done < "$PORT_REGISTRY" > "$tmp"
  mv "$tmp" "$PORT_REGISTRY"
  reg_unlock
}

# Echo a workspace's reserved ports, one per line.
ws_ports() { ws_get "$1" '.ports[]'; }

# How many ports to reserve: explicit override (--ports) > NTREE_PORTS length > NTREE_PORT_COUNT.
# Args: [override]
_resolve_port_count() {
  local override="${1:-}"
  [[ -n "$override" ]] && { echo "$override"; return; }
  local -a names; read -ra names <<< "$NTREE_PORTS"
  (( ${#names[@]} > 0 )) && { echo "${#names[@]}"; return; }
  echo "$NTREE_PORT_COUNT"
}

# Write <path>/.env.workspace with the workspace id + PORT, PORT2, PORT3, ...
# When NTREE_PORTS names are set, each port also gets a positional <NAME>_PORT alias.
# Args: <path> <name> <port...>
_write_env() {
  local path="$1" name="$2"; shift 2
  local pf="$path/.env.workspace" i=1 p
  local -a names; read -ra names <<< "$NTREE_PORTS"   # optional friendly names, positional
  echo "NTREE_WORKSPACE=$name" > "$pf"     # stable per-workspace key for DB/service isolation
  for p in "$@"; do
    if (( i == 1 )); then echo "PORT=$p" >> "$pf"; else echo "PORT$i=$p" >> "$pf"; fi
    local nm="${names[$((i-1))]:-}"
    [[ -n "$nm" ]] && echo "${nm}_PORT=$p" >> "$pf"
    (( i++ ))
  done
}

# A workspace always lives at .ntree/<name>; derived, never stored, so state
# survives moving the repo.
ws_path() { printf '%s\n' "$NTREE_DIR/$1"; }

ws_exists() { [[ "$(state_get '.workspaces | has($n)' --arg n "$1")" == true ]]; }
require_ws() { ws_exists "$1" || die "no such workspace: $1"; }

# Die unless a flag got a value. Args: <flag> <value>
_need_val() { [[ -n "${2:-}" && "$2" != -* ]] || die "$1 needs a value"; }

# Branch names map to workspace names with '/' → '-', so 'a/b' and 'a-b' collide.
# Refuse to reuse a workspace that belongs to a different branch.
# Caller must hold the state lock. Args: <name> <branch>
_check_ws_branch() {
  local have; have="$(ws_get "$1" '.branch')"
  [[ "$have" == "$2" ]] && return 0
  unlock
  die "workspace name '$1' is already used by branch '$have' (branch '$2' maps to the same name)"
}

# Path of the repo's info/exclude. It lives in the common git dir, so one entry
# covers the main checkout and every worktree.
_exclude_file() {
  local excl; excl="$(git -C "$REPO_ROOT" rev-parse --git-path info/exclude)"
  [[ "$excl" = /* ]] || excl="$REPO_ROOT/$excl"
  echo "$excl"
}

# Add ignore patterns to info/exclude, never gluing one onto an unterminated
# last line. Args: <pattern...>
_exclude_add() {
  local excl p; excl="$(_exclude_file)"
  mkdir -p "$(dirname "$excl")"
  touch "$excl"
  for p in "$@"; do
    grep -qxF "$p" "$excl" && continue
    [[ -s "$excl" && -n "$(tail -c1 "$excl")" ]] && printf '\n' >> "$excl"
    printf '%s\n' "$p" >> "$excl"
  done
}

# ntree's own files: the workspaces folder, per-workspace env and log.
_exclude_ntree_files() { _exclude_add '/.ntree/' '.env.workspace' 'ntree.log'; }

# ---------------------------------------------------------------------------
# Linked paths — untracked files/dirs shared live across workspaces
# ---------------------------------------------------------------------------
# Echo NTREE_LINK_PATHS one per line, normalized (no trailing slash). Read with
# `read -a` rather than a bare $VAR so a pattern-like entry is never globbed.
_link_paths() {
  local -a paths; read -ra paths <<< "$NTREE_LINK_PATHS"
  (( ${#paths[@]} )) || return 0      # bash 3.2: an empty "${a[@]}" trips set -u
  local p
  for p in "${paths[@]}"; do printf '%s\n' "${p%/}"; done
}

# Die on entries that can't work: absolute, escaping the repo, inside .ntree/,
# also cloned, or tracked by git (tracked files are already shared through git).
_validate_link_paths() {
  local p
  local -a clones; read -ra clones <<< "$NTREE_CLONE_DIRS"
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    [[ "$p" == /* ]] && die "NTREE_LINK_PATHS: '$p' must be relative to the repo root"
    [[ "/$p/" == */../* || "/$p/" == */./* ]] && die "NTREE_LINK_PATHS: '$p' must not contain '.' or '..'"
    [[ "$p" == .ntree || "$p" == .ntree/* || "$p" == .git || "$p" == .git/* ]] \
      && die "NTREE_LINK_PATHS: '$p' is reserved"
    local c; for c in ${clones[@]+"${clones[@]}"}; do
      [[ "${c%/}" == "$p" ]] && die "'$p' is in both NTREE_LINK_PATHS and NTREE_CLONE_DIRS — pick one"
    done
    if git -C "$REPO_ROOT" ls-files --error-unmatch -- "$p" >/dev/null 2>&1; then
      die "NTREE_LINK_PATHS: '$p' is tracked by git — tracked files reach workspaces through git, don't link them"
    fi
  done < <(_link_paths)
}

# Relative symlink target for <p> inside a workspace: up past .ntree/<name>/ and
# p's own parent dirs, back into the main checkout. Relative, so moving the
# whole repo keeps links working.
_link_target() {
  local p="$1" slashes="${1//[^\/]/}" up="../../" i
  for (( i = 0; i < ${#slashes}; i++ )); do up+="../"; done
  printf '%s%s\n' "$up" "$p"
}

# Create/repair the links in one workspace, keep them git-ignored, and remove
# links for paths no longer listed. Idempotent. Args: <name> <workspace_path>
_link_ws() {
  local name="$1" path="$2" p dst target current
  _validate_link_paths
  current="$(_link_paths)"
  # Linked last time but no longer configured: remove the link, never the source.
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    grep -qxF -- "$p" <<< "$current" && continue
    [[ -L "$path/$p" ]] && { rm "$path/$p"; ok "unlinked $p"; }
  done < <(ws_get "$name" '.links[]?')
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    # A symlink is a file to git, so 'dir/' would never match it: use '/p'.
    _exclude_add "/$p"
    if [[ ! -e "$REPO_ROOT/$p" ]]; then
      warn "link source missing: $p — create it in $REPO_ROOT, then run 'ntree sync'"; continue
    fi
    dst="$path/$p"; target="$(_link_target "$p")"
    if [[ -L "$dst" ]]; then
      [[ "$(readlink "$dst")" == "$target" ]] && continue
      rm "$dst"                       # stale/broken link: replace it
    elif [[ -e "$dst" ]]; then
      warn "$p already exists in $(basename "$path") (tracked on its branch?) — not linking"; continue
    fi
    mkdir -p "$(dirname "$dst")"
    ln -s "$target" "$dst"
    ok "linked $p"
  done <<< "$current"
}

# Report link problems in one workspace (for doctor). Echoes one issue per line.
# Args: <name> <workspace_path>
_link_issues() {
  local name="$1" path="$2" p dst current
  current="$(_link_paths)"
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    grep -qxF -- "$p" <<< "$current" && continue
    [[ -L "$path/$p" ]] && echo "$p: stale link, no longer in NTREE_LINK_PATHS — run 'ntree sync'"
  done < <(ws_get "$name" '.links[]?')
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    dst="$path/$p"
    if [[ -L "$dst" ]]; then
      [[ -e "$dst" ]] || echo "$p: broken link — restore it in the main checkout"
    elif [[ -e "$dst" ]]; then
      echo "$p: is a real file/dir, not a link — its branch tracks it; drop it from NTREE_LINK_PATHS or untrack it"
    else
      echo "$p: not linked — run 'ntree sync'"
    fi
  done <<< "$current"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_new() {
  local branch="" base="" ports=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from)  _need_val "$1" "${2:-}"; base="$2"; shift 2 ;;
      --ports) _need_val "$1" "${2:-}"; ports="$2"; shift 2 ;;
      -*)      die "unknown flag: $1" ;;
      *)       branch="$1"; shift ;;
    esac
  done
  [[ -n "$branch" ]] || die "usage: ntree new <branch> [--from <base>] [--ports <n>]"
  [[ -z "$ports" || "$ports" =~ ^[1-9][0-9]*$ ]] || die "--ports must be a positive integer"

  local name="${branch//\//-}"
  local path="$NTREE_DIR/$name"

  lock
  if ws_exists "$name"; then
    _check_ws_branch "$name" "$branch"
    unlock; die "workspace already exists: $name"
  fi
  _reserve_ws "$name" "$branch" "$ports"
  unlock
  _build_ws "$name" "$branch" "$base"
  ports="$(ws_ports "$name" | tr '\n' ' ')"

  _run_setup "$name" "$path"

  ok "created workspace ${C_BLD}$name${C_RST} (branch $branch, port(s): ${ports% })"
  info "  path: $path"
  info "  start it with: ${C_BLD}ntree run $name -d -- <cmd>${C_RST}"
}

# Warn if the new workspace's lockfile differs from the cloned deps' source.
warn_lockfile_drift() {
  local path="$1" lf
  for lf in package-lock.json pnpm-lock.yaml yarn.lock poetry.lock uv.lock; do
    if [[ -f "$REPO_ROOT/$lf" && -f "$path/$lf" ]] \
       && ! cmp -s "$REPO_ROOT/$lf" "$path/$lf"; then
      warn "$lf differs from main — cloned deps may be stale; run your installer in $path"
    fi
  done
}

# COW-clone NTREE_CLONE_DIRS from main into a workspace. Skips dirs the branch
# tracks. refresh=1 replaces existing copies (sync-deps); refresh=0 keeps them.
# Args: <path> <refresh>
_clone_dirs() {
  local path="$1" refresh="$2" d src cloned=0
  local -a dirs; read -ra dirs <<< "$NTREE_CLONE_DIRS"
  for d in ${dirs[@]+"${dirs[@]}"}; do
    d="${d%/}"; src="$REPO_ROOT/$d"
    [[ -e "$src" ]] || continue
    git -C "$path" ls-files --error-unmatch -- "$d" >/dev/null 2>&1 && continue
    # Python virtualenvs hardcode absolute paths — a cloned one is broken.
    if [[ -f "$src/pyvenv.cfg" || -f "$src/bin/activate" ]]; then
      warn "$d is a Python virtualenv (absolute paths) — not cloning; create it with NTREE_SETUP_CMD"
      continue
    fi
    if [[ -e "$path/$d" ]]; then
      (( refresh )) || continue
      rm -rf "${path:?}/$d"
    fi
    if cow_copy "$src" "$path/$d"; then ok "cloned $d (copy-on-write)"
    else
      # A failed clone can leave a partial copy; clear it or cp -R nests inside it.
      warn "copy-on-write clone failed for $d; plain copy (uses disk)"
      rm -rf "${path:?}/$d"; cp -R "$src" "$path/$d"
    fi
    cloned=1
  done
  (( cloned )) && warn_lockfile_drift "$path"
  return 0
}

# Echo the worktree that has <branch> checked out, if any. Args: <branch>
_checked_out_at() {
  git -C "$REPO_ROOT" worktree list --porcelain | awk -v b="branch refs/heads/$1" '
    /^worktree / { wt = substr($0, 10) }
    $0 == b      { print wt; exit }'
}

# Branch new workspaces start from when --from isn't given: the repo's default
# branch (origin/HEAD), preferring the local copy; falls back to main/master,
# then to whatever the main checkout has checked out.
_default_base() {
  local b c
  b="$(git -C "$REPO_ROOT" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  b="${b#origin/}"
  for c in $b main master; do
    git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$c" && { echo "$c"; return; }
  done
  if [[ -n "$b" ]]; then echo "origin/$b"; else echo HEAD; fi
}

# Step 1 of creating a workspace, under the state lock and fast: validate config,
# reserve ports and record the workspace, so the name and ports are taken before
# the slow part runs. Args: <name> <branch> [port_count_override]
_reserve_ws() {
  local name="$1" branch="$2" port_override="${3:-}" path
  path="$(ws_path "$name")"
  if [[ -e "$path" ]]; then
    unlock; die "$path already exists but isn't a workspace — move it away first"
  fi
  local holder; holder="$(_checked_out_at "$branch")"
  if [[ -n "$holder" ]]; then
    unlock
    if [[ "$holder" == "$REPO_ROOT" ]]; then die "branch $branch is checked out in the main checkout — switch it to another branch first"
    else die "branch $branch is checked out in $holder — 'ntree cd $(basename "$holder")', or switch that worktree to another branch"; fi
  fi
  _validate_link_paths
  local count; count="$(_resolve_port_count "$port_override")"
  reg_lock      # hold it from picking ports until they're recorded
  local ports; ports="$(alloc_ports "$count")"
  state_update '.workspaces[$n] = {branch:$b, ports:($ports|split(" ")|map(tonumber)), links:($l|split("\n")|map(select(length > 0))), pid:null, created:$ts}' \
    --arg n "$name" --arg b "$branch" --arg l "$(_link_paths)" \
    --arg ports "$ports" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  # shellcheck disable=SC2086  # one argument per port
  _registry_set "$path" $ports
  reg_unlock
}

# Step 2, without the lock so parallel `new`s don't wait on each other: the
# worktree, cloned dirs, links and env. On failure everything is rolled back,
# including the reservation. Args: <name> <branch> <base>
_build_ws() {
  local name="$1" branch="$2" base="$3" path existed=0 rc=0
  path="$(ws_path "$name")"
  git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$branch" && existed=1
  NEW_BRANCH_TIP=""
  # Ctrl-C/TERM reach the build too and stop it; ntree survives to roll back.
  # Restore the caller's trap afterwards (run --rm has its own).
  local saved interrupted before="$INTERRUPTED"; saved="$(trap -p INT TERM)"
  INTERRUPTED=0
  trap 'INTERRUPTED=1' INT TERM
  set +e
  (
    set -e
    if (( existed )); then
      [[ -z "$base" ]] || warn "branch $branch already exists — ignoring --from $base"
      git -C "$REPO_ROOT" worktree add "$path" "$branch" >&2
    else
      git -C "$REPO_ROOT" worktree add -b "$branch" "$path" "${base:-$(_default_base)}" >&2
    fi
    _clone_dirs "$path" 0
    _link_ws "$name" "$path"
    local -a wsports; read -ra wsports <<< "$(ws_ports "$name" | tr '\n' ' ')"
    _write_env "$path" "$name" "${wsports[@]}"
    _exclude_ntree_files
  )
  rc=$?
  set -e
  if [[ -n "$saved" ]]; then eval "$saved"; else trap - INT TERM; fi
  interrupted="$INTERRUPTED"; (( before )) && INTERRUPTED=1
  (( interrupted && ! rc )) && rc=130
  if (( rc )); then
    git -C "$REPO_ROOT" worktree remove --force "$path" >/dev/null 2>&1 || rm -rf "${path:?}"
    (( existed )) || git -C "$REPO_ROOT" branch -D "$branch" >/dev/null 2>&1 || true
    _registry_set "$path"
    lock; state_update 'del(.workspaces[$n])' --arg n "$name"; unlock
    (( interrupted )) && die "interrupted — rolled back workspace $name"
    die "could not create workspace $name (rolled back)"
  fi
  (( existed )) || NEW_BRANCH_TIP="$(git -C "$REPO_ROOT" rev-parse "refs/heads/$branch")"
  return 0
}

# Run NTREE_SETUP_CMD in a workspace to install deps (no-op if unset). Runs
# OUTSIDE the state lock — installs can be slow. Args: <name> <path>
_run_setup() {
  local name="$1" path="$2"
  [[ -n "${NTREE_SETUP_CMD:-}" ]] || return 0
  info "setup ($name): $NTREE_SETUP_CMD"
  local rc=0
  set +e +o pipefail
  ( cd "$path" && set -a && . ./.env.workspace && set +a && bash -c "$NTREE_SETUP_CMD" ) 2>&1 | tee -a "$path/ntree.log"
  rc=${PIPESTATUS[0]}
  set -e -o pipefail
  (( rc == 0 )) && ok "setup complete" || warn "setup exited $rc — deps may be incomplete"
}

# Tear down a workspace: kill process, remove worktree, drop from state.
# Args: <name> <path>
_remove_ws() {
  local name="$1" path="$2" pid
  pid="$(ws_pid "$name")"
  [[ -n "$pid" ]] && { kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true; }
  free_ports "$path"   # kill any untracked server still running in the worktree
  git -C "$REPO_ROOT" worktree remove --force "$path" 2>/dev/null || rm -rf "$path"
  _registry_set "$path"
  lock
  state_update 'del(.workspaces[$n])' --arg n "$name"
  unlock
}

# Run a command in a workspace's worktree. Foreground by default (attached to
# your terminal, returns the command's exit code); with -d it runs detached in
# the background, logged to ntree.log (stop with `ntree stop`). Creates the
# workspace if missing. After `--`, a single argument is a shell string ('npm run
# dev -- --port $PORT' expands $PORT at run time); several arguments run exactly
# as given. Falls back to a remembered command, then to NTREE_START_CMD.
cmd_run() {
  local branch="" base="" do_rm=0 detach=0 ports=""
  local -a cmd=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from)       _need_val "$1" "${2:-}"; base="$2"; shift 2 ;;
      --ports)      _need_val "$1" "${2:-}"; ports="$2"; shift 2 ;;
      --rm)         do_rm=1; shift ;;
      -d|--detach)  detach=1; shift ;;
      --)           shift; cmd=("$@"); break ;;
      -*)           die "unknown flag: $1" ;;
      *)            branch="$1"; shift ;;
    esac
  done
  [[ -n "$branch" ]] || die "usage: ntree run <branch> [--from <base>] [--ports <n>] [-d] [--rm] -- <cmd...>"
  [[ -z "$ports" || "$ports" =~ ^[1-9][0-9]*$ ]] || die "--ports must be a positive integer"
  (( detach && do_rm )) && die "--detach and --rm can't be combined"

  # With --rm, catch Ctrl-C/TERM from the start: wherever it lands, ntree keeps
  # going far enough to remove what it created.
  (( do_rm )) && trap 'INTERRUPTED=1' INT TERM

  local name="${branch//\//-}" created=0
  lock
  if ws_exists "$name"; then
    _check_ws_branch "$name" "$branch"
  else
    _reserve_ws "$name" "$branch" "$ports"; created=1
  fi
  unlock
  (( created )) && _build_ws "$name" "$branch" "$base"

  local path log
  path="$(ws_path "$name")"
  log="$path/ntree.log"
  (( created )) && _run_setup "$name" "$path"

  # Resolve the command: explicit `-- cmd` (remembered) > remembered > NTREE_START_CMD
  local cmd_str=""
  if (( ${#cmd[@]} == 1 )); then
    cmd_str="${cmd[0]}"
  elif (( ${#cmd[@]} > 1 )); then
    cmd_str="$(printf '%q ' "${cmd[@]}")"; cmd_str="${cmd_str% }"
  fi
  if [[ -n "$cmd_str" ]]; then
    lock; state_update '.workspaces[$n].cmd = $c' --arg n "$name" --arg c "$cmd_str"; unlock
  else
    cmd_str="$(ws_get "$name" '.cmd // empty')"
    [[ -z "$cmd_str" ]] && cmd_str="${NTREE_START_CMD:-}"
  fi
  [[ -n "$cmd_str" ]] || die "no command — put it after --, e.g: ntree run $name -- npm test"

  if (( detach )); then
    _run_detached "$name" "$path" "$log" "$cmd_str"
    return 0
  fi

  local port; port="$(ws_get "$name" '.ports[0]')"
  (( created )) && info "created workspace $name (branch $branch)" \
                || info "reusing workspace $name (on branch $(ws_branch "$name"))"
  info "running (PORT=$port): $cmd_str"

  # No pipe through tee here: the command keeps your terminal (colors, prompts).
  # The command gets Ctrl-C from the terminal as usual; with --rm ntree's trap
  # keeps it alive to clean up. Interrupted before the command started? Skip it.
  local rc=0
  if (( INTERRUPTED )); then
    rc=130
  else
    ( cd "$path" && set -a && . ./.env.workspace && set +a && exec bash -c "$cmd_str" ) || rc=$?
  fi
  (( do_rm )) && trap - INT TERM
  (( INTERRUPTED )) && info "interrupted"

  if (( do_rm )); then
    if (( ! created )); then
      warn "--rm: kept $name — it existed before this run"
    else
      _remove_ws "$name" "$path"
      info "removed workspace $name"
      # Drop the branch too if this run created it and nothing was committed on it.
      if [[ -n "$NEW_BRANCH_TIP" ]]; then
        if [[ "$(git -C "$REPO_ROOT" rev-parse "refs/heads/$branch")" == "$NEW_BRANCH_TIP" ]]; then
          git -C "$REPO_ROOT" branch -D "$branch" >/dev/null
        else
          info "kept branch $branch — it has new commits"
        fi
      fi
    fi
  fi
  if (( rc == 0 )); then ok "run finished (exit 0)"; else warn "run exited $rc"; fi
  return "$rc"
}

# Launch a command detached (own process group), track its PID. Args: name path log cmd
_run_detached() {
  local name="$1" path="$2" log="$3" cmd_str="$4"
  local pid; pid="$(ws_pid "$name")"
  [[ -n "$pid" ]] && die "workspace $name already running (pid $pid)"

  # Ports were reserved at `new` time — reallocate the set if one was grabbed since.
  local conflict=0 p
  for p in $(ws_ports "$name"); do port_listening "$p" && conflict=1; done
  if (( conflict )); then
    warn "assigned port(s) now in use by another process — reallocating"
    local cnt newports; cnt="$(ws_ports "$name" | grep -c .)"
    lock; reg_lock
    newports="$(alloc_ports "$cnt")"
    _write_env "$path" "$name" $newports
    state_update '.workspaces[$n].ports = ($p|split(" ")|map(tonumber))' \
      --arg n "$name" --arg p "$newports"
    _registry_set "$path" $newports
    reg_unlock; unlock
  fi
  local port; port="$(ws_get "$name" '.ports[0]')"

  info "starting (detached): $cmd_str (PORT=$port) → $log"
  # Job control makes the background job its own process-group leader (portable,
  # unlike setsid, which macOS lacks), so `stop` can kill the whole tree via $newpid.
  set -m
  ( cd "$path" && set -a && . ./.env.workspace && set +a && exec bash -c "$cmd_str" ) >"$log" 2>&1 &
  local newpid=$!
  set +m

  lock
  state_update '.workspaces[$n].pid = ($pid|tonumber) | .workspaces[$n].pid_start = $start' \
    --arg n "$name" --arg pid "$newpid" --arg start "$(pid_start "$newpid")"
  unlock
  ok "started $name (pid $newpid, port $port)"
}

# The table goes to stdout (so it can be piped); colors only when that's a terminal.
cmd_list() {
  local bld="" grn="" dim="" rst=""
  [[ -t 1 ]] && { bld=$'\033[1m' grn=$'\033[32m' dim=$'\033[2m' rst=$'\033[0m'; }
  printf '%s%-20s %-24s %-6s %-9s %s%s\n' "$bld" NAME BRANCH PORT STATUS PATH "$rst"
  # The primary checkout isn't an ntree workspace, but it's part of the picture.
  local root_branch; root_branch="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
  printf '%-20s %-24s %-6s %-9s %s\n' "(root)" "$root_branch" "-" "-" "$REPO_ROOT"
  local names; names="$(state_get '.workspaces | keys[]' 2>/dev/null || true)"
  if [[ -z "$names" ]]; then info "no workspaces yet — create one with: ntree new <branch>"; return; fi
  local n
  while IFS= read -r n; do
    local branch port pid path status
    branch="$(ws_branch "$n")"
    port="$(ws_get "$n" '.ports[0]')"
    pid="$(ws_pid "$n")"
    path="$(ws_path "$n")"
    local pc; pc="$(ws_get "$n" '.ports | length')"
    (( pc > 1 )) && port="$port+$((pc-1))"
    # pad before coloring so escape codes don't break the column width
    if [[ -n "$pid" ]]; then status="$grn$(printf '%-9s' running)$rst"; else status="$dim$(printf '%-9s' stopped)$rst"; fi
    printf '%-20s %-24s %-6s %s %s\n' "$n" "$branch" "$port" "$status" "$path"
  done <<< "$names"
}

cmd_stop() {
  local name="${1:-}"; [[ -n "$name" ]] || die "usage: ntree stop <name>"
  init_env; require_ws "$name"
  local pid path; pid="$(ws_pid "$name")"
  path="$(ws_path "$name")"
  if [[ -n "$pid" ]]; then
    kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
    ok "stopped $name (pid $pid)"
  else
    info "$name is not running"
  fi
  free_ports "$path"   # also reclaim ports from any untracked server in the worktree
  lock
  state_update '.workspaces[$n].pid = null | .workspaces[$n].pid_start = null' --arg n "$name"
  unlock
}

cmd_open() {
  local name="${1:-}"; [[ -n "$name" ]] || die "usage: ntree open <name>"
  init_env; require_ws "$name"
  local path; path="$(ws_path "$name")"
  if [[ -n "${EDITOR:-}" ]]; then
    local -a editor; read -ra editor <<< "$EDITOR"     # may carry flags, e.g. 'code -w'
    "${editor[@]}" "$path"
  elif command -v code >/dev/null 2>&1; then code "$path"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$path"
  else open "$path"; fi
}

# Print a workspace's absolute worktree path to stdout (for shell integration).
cmd_path() {
  local name="${1:-}"; [[ -n "$name" ]] || die "usage: ntree path <name>"
  require_ws "$name"
  ws_path "$name"
}

# Print a shell function that adds `cd` support. Add to ~/.zshrc / ~/.bashrc:
#   eval "$(ntree shell-init)"
# Then `ntree <workspace>` (or `ntree cd <workspace>`) changes directory.
cmd_shell_init() {
  local cmds; cmds="$(printf '%s|' $NTREE_COMMANDS __complete --version -v --help -h)"
  cat <<SH
ntree() {
  if [ "\$1" = "cd" ]; then
    local __d; __d="\$(command ntree path "\${2:-}")" || return
    cd "\$__d"
    return
  fi
  case "\${1:-}" in
    ""|${cmds%|})
      command ntree "\$@" ;;
    *)
      local __d
      if __d="\$(command ntree path "\$1" 2>/dev/null)"; then cd "\$__d"; else command ntree "\$@"; fi ;;
  esac
}
SH
}

# Hidden helper for the shell completions, so they share the command list and
# find workspaces from inside a worktree too. Never creates .ntree/.
# Args: commands | workspaces
cmd_complete() {
  case "${1:-}" in
    commands) printf '%s\n' $NTREE_COMMANDS ;;
    workspaces)
      local root; root="$(repo_root 2>/dev/null)" || return 0
      [[ -f "$root/.ntree/state.json" ]] || return 0
      jq -r '.workspaces | keys[]' "$root/.ntree/state.json" 2>/dev/null || true ;;
  esac
}

# Run any git command in a workspace's worktree. Everything after <name>
# is passed straight to git; exit code is git's.
cmd_git() {
  local name="${1:-}"; [[ -n "$name" ]] || die "usage: ntree git <name> <git-args...>"
  shift
  require_ws "$name"
  local path; path="$(ws_path "$name")"
  git -C "$path" "$@"
}

# Trust this repo's .ntreerc so init_env will source it. Re-run after edits.
cmd_allow() {
  [[ -f "$RC_FILE" ]] || die "no .ntreerc at $REPO_ROOT"
  local h; h="$(rc_hash "$RC_FILE")"
  if rc_is_allowed "$h"; then info ".ntreerc already trusted"; return; fi
  mkdir -p "$(dirname "$ALLOW_FILE")"
  printf '%s\n' "$h" >> "$ALLOW_FILE"
  ok "trusted .ntreerc — it will now be loaded (re-run 'ntree allow' after edits)"
}

# sync acts on the config, so an untrusted (e.g. just edited) .ntreerc must not
# silently fall back to defaults — that would read as "no links" and remove them.
_require_trusted_rc() {
  [[ -f "$RC_FILE" ]] || return 0
  rc_is_allowed "$(rc_hash "$RC_FILE")" \
    || die ".ntreerc changed since you trusted it — review it, run 'ntree allow', then sync again"
}

# Echo the target workspace (validated), or all workspaces. Args: [<name>]
_target_names() {
  if [[ -n "${1:-}" ]]; then require_ws "$1"; echo "$1"
  else state_get '.workspaces | keys[]'; fi
}

# Create/repair linked paths and remove ones no longer listed. Cheap; run it
# after editing NTREE_LINK_PATHS. Args: [<name>] (default: all workspaces)
cmd_sync() {
  _require_trusted_rc
  local names n path; names="$(_target_names "${1:-}")"
  [[ -n "$names" ]] || { info "no workspaces to sync"; return 0; }
  if [[ -z "$NTREE_LINK_PATHS" && "$(state_get '[.workspaces[].links[]?] | length')" == 0 ]]; then
    warn "nothing to sync — set NTREE_LINK_PATHS in .ntreerc (for dependencies use 'ntree sync-deps')"
    return 0
  fi
  while IFS= read -r n; do
    path="$(ws_path "$n")"
    [[ -d "$path" ]] || { warn "$n: worktree folder missing — skipping (run 'ntree doctor')"; continue; }
    _link_ws "$n" "$path"
    lock
    state_update '.workspaces[$n].links = ($l|split("\n")|map(select(length > 0)))' --arg n "$n" --arg l "$(_link_paths)"
    unlock
  done <<< "$names"
}

# Refresh dependencies: re-clone NTREE_CLONE_DIRS, then re-run NTREE_SETUP_CMD.
# Use after a lockfile change in main. Args: [<name>] (default: all workspaces)
cmd_sync_deps() {
  _require_trusted_rc
  local names n path; names="$(_target_names "${1:-}")"
  [[ -n "$names" ]] || { info "no workspaces to sync"; return 0; }
  if [[ -z "${NTREE_CLONE_DIRS:-}" && -z "${NTREE_SETUP_CMD:-}" ]]; then
    warn "nothing to sync — set NTREE_SETUP_CMD (e.g. 'npm ci') or NTREE_CLONE_DIRS in .ntreerc"
    return 0
  fi
  while IFS= read -r n; do
    path="$(ws_path "$n")"
    [[ -d "$path" ]] || { warn "$n: worktree folder missing — skipping (run 'ntree doctor')"; continue; }
    info "syncing deps into $n"
    _clone_dirs "$path" 1
    _run_setup "$n" "$path"
  done <<< "$names"
}

cmd_rm() {
  local name="" force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force|-f) force=1; shift ;;
      -*)         die "unknown flag: $1" ;;
      *)          name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "usage: ntree rm <name> [--force]"
  init_env; require_ws "$name"
  local path; path="$(ws_path "$name")"

  if (( ! force )); then
    local dirty; dirty="$(git -C "$path" status --porcelain 2>/dev/null || true)"
    if [[ -n "$dirty" ]]; then
      printf '%s\n' "$dirty" >&2
      die "$name has uncommitted changes (above) — commit or stash them, or discard them with 'ntree rm $name --force'"
    fi
    printf 'Remove workspace %s and its folder? [y/N] ' "$name" >&2
    read -r reply; [[ "$reply" =~ ^[Yy]$ ]] || { info "aborted"; return; }
  fi

  _remove_ws "$name" "$path"
  ok "removed workspace $name"
}

cmd_doctor() {
  local rc=0
  need git; need jq
  local gv; gv="$(git --version | grep -oE '[0-9]+\.[0-9]+' | head -1)"
  if [[ "$(printf '%s\n2.40\n' "$gv" | sort -V | head -1)" == "2.40" ]]; then
    ok "git $gv (>= 2.40)"
  else
    warn "git $gv is older than recommended 2.40"; rc=1
  fi
  if [[ "$(uname -s)" == "Darwin" ]]; then
    if diskutil info / 2>/dev/null | grep -q 'APFS'; then
      ok "root filesystem is APFS (copy-on-write clones available)"
    else
      warn "root filesystem is not APFS — clones fall back to full copies"; rc=1
    fi
  else
    local fst; fst="$(stat -f -c %T . 2>/dev/null || true)"
    case "$fst" in
      btrfs|xfs|bcachefs) ok "filesystem is $fst (reflink clones available)" ;;
      *) warn "filesystem is '${fst:-unknown}' — reflink clones likely unavailable; clones fall back to full copies (fine if NTREE_CLONE_DIRS is unset)" ;;
    esac
  fi
  command -v lsof >/dev/null 2>&1 || { warn "lsof missing (needed to reclaim untracked servers on teardown)"; rc=1; }
  command -v nc >/dev/null 2>&1 && ok "nc present (port probing)" || { warn "nc missing"; rc=1; }

  init_env
  if ! _state_readable; then
    local bad; bad="$STATE_FILE.corrupt-$(date +%Y%m%d%H%M%S)"
    mv "$STATE_FILE" "$bad"
    warn "state.json was unreadable — rebuilding it from the workspaces on disk (old copy: $bad)"
    _rebuild_state
  fi
  if [[ -f "$RC_FILE" ]]; then
    if rc_is_allowed "$(rc_hash "$RC_FILE")"; then ok ".ntreerc is trusted"
    else warn ".ntreerc present but not trusted — run 'ntree allow' to load it"; fi
  fi

  # Clear a stale state lock left by a crashed process.
  if [[ -d "$LOCK_DIR" ]]; then
    local lh; lh="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
    if [[ -z "$lh" ]] || ! kill -0 "$lh" 2>/dev/null; then
      rm -rf "$LOCK_DIR"; ok "cleared stale state lock"
    else
      warn "state lock currently held by live pid $lh"
    fi
  fi

  [[ -d "$NTREE_DIR" ]] && _exclude_ntree_files

  _registry_prune


  # Reconcile state.json against reality: prune missing worktrees, flag deleted
  # branches, clear dead PIDs.
  local names; names="$(state_get '.workspaces | keys[]' 2>/dev/null || true)"
  local n cleaned=0
  while IFS= read -r n; do
    [[ -z "$n" ]] && continue
    local path branch pid
    path="$(ws_path "$n")"
    branch="$(ws_get "$n" '.branch')"
    pid="$(ws_get "$n" '.pid')"
    if [[ ! -d "$path" ]]; then
      lock; state_update 'del(.workspaces[$n])' --arg n "$n"; unlock
      _registry_set "$path"
      warn "pruned '$n' from state — worktree folder missing ($path)"; cleaned=1; continue
    fi
    # Reconnect the worktree if the repo was moved (git stores absolute paths).
    git -C "$REPO_ROOT" worktree repair "$path" >/dev/null 2>&1 || true
    # (re)register, e.g. workspaces made by older versions
    local -a wsports; read -ra wsports <<< "$(ws_ports "$n" | tr '\n' ' ')"
    _registry_set "$path" ${wsports[@]+"${wsports[@]}"}
    if ! git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$branch"; then
      warn "'$n' tracks branch '$branch' which no longer exists"
    fi
    local now; now="$(ws_branch "$n")"
    [[ "$now" == "$branch" ]] || info "'$n' was created for $branch but is on $now now (fine; 'ntree run $branch' still uses it)"
    if [[ "$pid" != "null" && -z "$(ws_pid "$n")" ]]; then
      lock; state_update '.workspaces[$n].pid = null | .workspaces[$n].pid_start = null' --arg n "$n"; unlock
      info "cleared stale pid for $n"; cleaned=1
    fi
    local issue
    while IFS= read -r issue; do
      [[ -n "$issue" ]] && { warn "'$n': $issue"; rc=1; }
    done < <(_link_issues "$n" "$path")
  done <<< "$names"

  # After repairing moved worktrees above, let git drop bookkeeping for ones
  # whose folders are really gone. (Pruning first would forget moved ones.)
  git -C "$REPO_ROOT" worktree prune 2>/dev/null || true

  # Flag folders under .ntree/ that aren't tracked in state (orphan worktrees).
  local d base
  for d in "$NTREE_DIR"/*/; do
    [[ -d "$d" ]] || continue
    base="$(basename "$d")"
    if ! state_get '.workspaces | keys[]' 2>/dev/null | grep -qx "$base"; then
      warn "untracked folder in .ntree/: $base (leftover? remove manually or 'git worktree remove')"
    fi
  done

  (( cleaned )) && ok "reconciled state with reality"
  ok "state file OK: $STATE_FILE"
  return $rc
}

usage() {
  cat >&2 <<EOF
${C_BLD}ntree${C_RST} — parallel git worktree workspaces (v$NTREE_VERSION)

${C_BLD}usage:${C_RST} ntree <command> [args]

  new <branch> [--from <base>] [--ports <n>]
                                 create workspace (worktree + ports; runs
                                 NTREE_SETUP_CMD to install deps if set).
                                 --ports overrides how many ports to reserve.
  run <branch> [-d] [--rm] -- <cmd...>
                                 run a command in the workspace's worktree
                                 (creates it if needed). Foreground: exits with
                                 cmd's code. With -d: detached/background, tracked
                                 by pid (stop with 'ntree stop'). Remembers cmd.
                                 One arg is a shell string; several run as given.
                                 --rm removes a workspace (and branch) it created.
  list                           show the root checkout + workspaces, branches, ports, status
  stop <name>                    stop the process and free the workspace's ports
                                 (also kills untracked servers running in its worktree)
  open <name>                    open folder in \$EDITOR / VS Code / file manager
  git <name> <args...>           run any git command in the workspace's worktree
  sync [<name>]                  create/repair linked paths, remove unlisted ones
                                 (all workspaces if omitted)
  sync-deps [<name>]             refresh deps (re-clone, re-run setup)
  rm <name> [--force]            stop, free ports, remove worktree, delete folder
                                 (refuses uncommitted changes unless --force)
  allow                          trust this repo's .ntreerc so it gets loaded
  path <name>                    print a workspace's absolute path
  cd <name>                      cd into a workspace (needs shell integration)
  doctor                         check setup, repair moved worktrees, reconcile
                                 state and ports, flag link problems
  version                        print version
  help                           this message

shell integration (enables 'ntree <workspace>' and 'ntree cd <workspace>' to cd):
  add to ~/.zshrc or ~/.bashrc:   eval "\$(ntree shell-init)"

config: .ntreerc at repo root (sourced only after 'ntree allow'; see .ntreerc.example)
EOF
}

main() {
  local sub="${1:-help}"; NTREE_CMD="$sub"; shift || true
  case "$sub" in
    new)     init_env; cmd_new "$@" ;;
    run)     init_env; cmd_run "$@" ;;
    list|ls) init_env; cmd_list "$@" ;;
    stop)    cmd_stop "$@" ;;
    open)    cmd_open "$@" ;;
    git)     init_env; cmd_git "$@" ;;
    sync)    init_env; cmd_sync "$@" ;;
    sync-deps) init_env; cmd_sync_deps "$@" ;;
    allow)   init_env; cmd_allow "$@" ;;
    rm)      cmd_rm "$@" ;;
    path)    init_env; cmd_path "$@" ;;
    shell-init) cmd_shell_init ;;
    __complete) cmd_complete "$@" ;;
    cd)      die "'ntree cd' needs shell integration — add to ~/.zshrc: eval \"\$(ntree shell-init)\"" ;;
    doctor)  cmd_doctor "$@" ;;
    version|--version|-v) echo "ntree $NTREE_VERSION" ;;
    help|--help|-h) usage ;;
    *) usage; die "unknown command: $sub" ;;
  esac
}

main "$@"
